PORT=5000

GROQ_API_KEY=
GROQ_MODEL=
GROQ_RERANKING_ENABLED=true
GROQ_RERANK_TIMEOUT_MS=5000
WATCH_HISTORY_COMPLETION_THRESHOLD=0.9

MONGO_URI=
# Optional explicit production database override. If unset, the URI path is
# used, or MongoDB's driver default database "test" when the path is absent.
MONGO_DATABASE_NAME=
# Dedicated test database. For Atlas, copy the scheme, credentials, cluster host,
# and connection options from MONGO_URI, changing only the database path to
# netflix_clone_test. Never set this to the production database name.
MONGO_TEST_URI=mongodb+srv://<username>:<password>@<cluster-host>/netflix_clone_test

JWT_SECRET=
JWT_EXPIRES_IN=
