PORT=5000
FRONTEND_URL=http://localhost:3000
# Multiple comma-separated exact origins are supported, for example:
# FRONTEND_URL=https://app.example.com,https://admin.example.com

GROQ_API_KEY=
GROQ_MODEL=
GROQ_RERANKING_ENABLED=true
GROQ_RERANK_TIMEOUT_MS=5000
WATCH_HISTORY_COMPLETION_THRESHOLD=0.9

MONGO_URI=
# Optional explicit production database override. If unset, the URI path is
# used, or MongoDB's driver default database "test" when the path is absent.
MONGO_DATABASE_NAME=
# Integration tests use the ephemeral local MongoDB service in
# docker-compose.test.yml. The test runner sets this URI itself; remote hosts
# are rejected by the test helper.
MONGO_TEST_URI=mongodb://127.0.0.1:27018/netflix_clone_test

JWT_SECRET=
JWT_EXPIRES_IN=
